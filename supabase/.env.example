# Server-only secrets: use `supabase secrets set --env-file ...`.
# Never prefix these with VITE_ or copy them into frontend .env.local.
APP_ORIGIN=https://rireki-easy.pages.dev
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_CREDITS_PRICE_ID=

# USD microdollars; 10000 = $0.01 reservation per attempt.
# Example starter budget $0.10/day, including failed calls. Set only after funding it.
AI_DAILY_BUDGET_MICRODOLLARS=100000
# At most five free attempts globally/day, even if many accounts sign up.
AI_FREE_DAILY_LIMIT=5

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase Edge.
