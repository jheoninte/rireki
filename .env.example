# Public Supabase project URL and publishable key. Never use a service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Enable only after applying the migration and verifying RLS on a staging project.
VITE_CLOUD_ENABLED=false
# Enable only after Edge Functions, Stripe webhook and AI budgets are configured.
VITE_COMMERCE_ENABLED=false
# Show only providers enabled in Supabase and configured with their OAuth app.
VITE_SOCIAL_PROVIDERS=google
\n+# Optional IndexNow ownership token, used only at build/submission time (no VITE_ prefix).
INDEXNOW_KEY=
# Example: google,github,linkedin_oidc,facebook,kakao

# Optional real affiliate destination (HTTPS). Empty = no affiliate promotion.
VITE_CAREER_PARTNER_URL=
